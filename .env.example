# ==============================================================================
# SMART LIGHT TRAP IoT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase Client Configuration (Frontend React)
# Gunakan URL dan Anon / Publishable Key dari dashboard Supabase Anda.
# Jangan pernah memasukkan service_role_key di sini!
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# 2. Cakupan Wilayah Operasional (Default: Subang, Jawa Barat)
VITE_OPERATIONAL_REGION="Subang, Jawa Barat"

# 3. Notifikasi Telegram Bot (Disimpan di Edge Function Secrets pada produksi)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_DEFAULT_CHAT_ID="-100xxxxxxxxxx"

# 4. Layanan Eksternal Computer Vision (Opsional Python FastAPI YOLOv8)
CV_SERVICE_URL="http://localhost:8000"
CV_SERVICE_SECRET="your-s2s-shared-secret"

# 5. Gemini AI Key (Opsional untuk analisis naratif PHT)
GEMINI_API_KEY="your-gemini-api-key"
APP_URL="http://localhost:3000"
